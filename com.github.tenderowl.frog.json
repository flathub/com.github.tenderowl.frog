{
    "app-id" : "com.github.tenderowl.frog",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "frog",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=xdg-pictures"
    ],
    "cleanup" : [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gir-1.0",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "leptonica.json",
        "tesseract.json",
        "libportal.json",
        "zbar.json",
        "python3-modules.json",
        "python3-gTTS.json",
        {
            "name": "frog",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tenderowl/frog.git",
                    "tag": "1.6.0"
                }
            ]
        }
    ]
}
